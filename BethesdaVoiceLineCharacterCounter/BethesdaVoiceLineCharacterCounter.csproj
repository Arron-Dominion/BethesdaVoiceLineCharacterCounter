<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>BethesdaVoiceLineCharacterCounter</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<Product>Bethesda Voice Line Character Counter</Product>
		<Version>1.0.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<AvaloniaResource Include="Resources\AppIcon\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.1" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
		<PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
			<IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
			<PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
		</PackageReference>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\BethesdaVoiceLineCharacterCounter.Application\BethesdaVoiceLineCharacterCounter.Application.csproj" />
		<ProjectReference Include="..\BethesdaVoiceLineCharacterCounter.Domain\BethesdaVoiceLineCharacterCounter.Domain.csproj" />
	</ItemGroup>

</Project>
